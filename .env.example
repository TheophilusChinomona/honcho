# ── Honcho Self-Hosted Configuration ──
# Copy this file to .env and fill in your values.
# All variables are optional unless marked REQUIRED.

# ── Database (ParadeDB / PostgreSQL + pgvector) ──
DB_CONNECTION_URI=postgresql+psycopg://postgres:postgres@localhost:5432/postgres  # REQUIRED
DB_SCHEMA=honcho

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── API Server ──
API_PORT=8000

# ── Auth (set AUTH_USE_AUTH=true to enable JWT-based authentication) ──
AUTH_USE_AUTH=false
# AUTH_JWT_SECRET=your-secret-here  # REQUIRED if AUTH_USE_AUTH=true

# ── LLM Providers (at least one REQUIRED for Deriver/Dialectic/Dreamer agents) ──
# Default: Honcho uses LLM_GEMINI_API_KEY (deriver), LLM_ANTHROPIC_API_KEY (dialectic/dream),
# LLM_OPENAI_API_KEY (embeddings). See model override patterns below to route everything to one provider.

# ── OpenRouter-first routing (recommended for self-hosted) ──
# Route all LLM calls through OpenRouter using OpenAI-compatible transport.
# Set one key and override per-model via TRANSPORT + BASE_URL + API_KEY_ENV.
# OPENROUTER_API_KEY=sk-or-v1-...

# Deriver example (routes to OpenRouter):
# DERIVER_MODEL_CONFIG__TRANSPORT=openai
# DERIVER_MODEL_CONFIG__MODEL=meta-llama/llama-3.1-8b-instruct:free
# DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# DERIVER_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=OPENROUTER_API_KEY

# Dialectic example (per-reasoning-level override):
# DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
# DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=meta-llama/llama-3.1-8b-instruct:free
# DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__API_KEY_ENV=OPENROUTER_API_KEY

# Summary example:
# SUMMARY_MODEL_CONFIG__TRANSPORT=openai
# SUMMARY_MODEL_CONFIG__MODEL=meta-llama/llama-3.1-8b-instruct:free
# SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# SUMMARY_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=OPENROUTER_API_KEY

# Dream example:
# DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
# DREAM_DEDUCTION_MODEL_CONFIG__MODEL=meta-llama/llama-3.1-8b-instruct:free
# DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=OPENROUTER_API_KEY

# ── Embeddings (for vector similarity search) ──
# Set EMBED_MESSAGES=false to disable embeddings entirely (e.g. OpenRouter free tier has no embedding models).
EMBED_MESSAGES=true
# EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
# EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-3-small
# EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=OPENROUTER_API_KEY

# ── Server Identity ──
BASE_URL=http://localhost:8000     # Public-facing URL for OpenAPI docs / CORS
CONTACT_EMAIL=                     # Shown in OpenAPI docs

# ── Vector Store + Retrieval ──
VECTOR_STORE_TYPE=pgvector
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_TOP_K=20
RETRIEVAL_FULLTEXT_USE_WEBSEARCH=true
RETRIEVAL_MMR_ENABLED=false

# ── Logging ──
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ── Optional: Telemetry (disabled by default for self-hosted) ──
# TELEMETRY_ENABLED=false

# ── Optional: Sentry error tracking ──
# SENTRY_ENABLED=false
# SENTRY_DSN=
